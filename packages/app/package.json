{
    "name": "@ocds/app",
    "version": "0.1.0",
    "description": "Local-first telemetry viewer for Open Catalyst Data Studio",
    "author": "Open Catalyst Data Studio contributors",
    "repository": "https://github.com/KJBurnett/open-garmin-catalyst-data-studio",
    "build": {
        "appId": "org.opencatalyst.datastudio",
        "productName": "Open Catalyst Data Studio",
        "executableName": "open-catalyst-data-studio",
        "linux": {
            "category": "Science",
            "target": ["AppImage"]
        }
    },
    "main": "dist-electron/main.js",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build && electron-builder --publish never",
        "preview": "vite preview"
    },
    "dependencies": {
        "@ocds/core": "*",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "recharts": "^2.10.4",
        "leaflet": "^1.9.4",
        "react-leaflet": "^4.2.1"
    },
    "devDependencies": {
        "@types/react": "^18.2.48",
        "@types/react-dom": "^18.2.18",
        "@vitejs/plugin-react": "^4.2.1",
        "electron": "28.3.3",
        "electron-builder": "^24.9.1",
        "typescript": "^5.3.3",
        "vite": "^5.0.12",
        "vite-plugin-electron": "^0.15.6",
        "vite-plugin-electron-renderer": "^0.14.5"
    }
}